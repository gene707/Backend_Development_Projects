{
  "name": "websocket-realtime-hub",
  "version": "1.0.0",
  "description": "Concurrent WebSocket Real-Time Communication Hub with Multi-Channel Routing, In-Memory User Caching (Redis), and Persistent Transaction File Logging",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
