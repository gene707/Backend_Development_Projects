    "cli:client": "node scripts/cliClient.js",
    "cli:demo": "node scripts/cliDemo.js"
  },
  "keywords": [
    "websocket",
    "real-time",
    "chat-channels",
    "redis",
    "in-memory-cache",
    "file-logger",
    "high-concurrency"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.1",
    "ws": "^8.18.0"
  }
